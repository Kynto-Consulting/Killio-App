{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. Remote pages may reach the IPC, but every command checks in Rust that the page is the launcher or the chosen tenant.",
  "windows": ["main", "content"],
  "webviews": ["content", "titlebar"],
  "local": true,
  "remote": {
    "urls": ["https://*", "http://localhost:*", "http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-app-state",
    "allow-probe-tenant",
    "allow-open-tenant",
    "allow-remove-tenant",
    "allow-switch-tenant",
    "allow-capture-screenshot",
    "allow-open-external",
    "allow-report-accounts",
    "allow-list-accounts",
    "allow-open-account",
    "allow-list-apps",
    "allow-open-app",
    "allow-save-screenshot",
    "allow-set-chrome",
    "allow-chrome-action",
    "allow-claude-status",
    "allow-claude-start",
    "allow-claude-stop",
    "allow-claude-models",
    "allow-claude-send",
    "allow-claude-poll",
    "allow-claude-cancel",
    "allow-device-action",
    "allow-notify",
    "allow-update-check",
    "allow-update-install"
  ]
}
