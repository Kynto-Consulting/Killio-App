{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Killio",
  "version": "0.1.0",
  "identifier": "dev.killio.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["killio"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["claude-bridge/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
